db.collectionName.aggregate([]) 


//how many users are active?
[
    { //first stage or query
        $match :{
            isActive: true
        }
    },
    {//second stage or query
        $count : "activeUsers"   // activeUsers:317
    }
]

// What is the average age of all users?
[{
    $group:{
        _id:null,//_id: null means:Treat all documents as one group if $id: "$age" then group age field  only  group Apple, A → add 1  C → add 1 👉 $sum: 1 → 1 + 1 = 2
        average:{
            $avg: "$age" // average:30

        }
    }
}]

//List the top 5 most common favorite fruits among the users?
[
    {
        $group:{
            _id:"$favoriteFruit",
            count : {
                $sum : 1 //“For every document in the group, add 1.”
            }
        }
    },
    {
        $sort:{        //👉 $sort is used to order the documents in the pipeline.
            count: -1  //-1 → descending order (highest → lowest), 1 → ascending order (lowest → highest)
        }
    },{
        $limit :5       //“Return only the first 5 documents from the pipeline result.”
    }
]

//find the total number of males and females
[{
    $group:{
        _id:"$gender",
        genderCount:{
            $sum: 1    // here $count(count how many documents are in a pipeline) count total documents where as $sum(Add 1 or each document in a group ) count or add values per group 
        }
    }
}]

//Which country has the highest number of registered users?
[
    {
        $group:{
            _id:"$company.location.country",
            userCount:{
                $sum: 1
            }
        }
    },
    {
        $sort:{
            userCount: -1
        }
    },
    {
        $limit: 1
    }
]

//List all the uniqure eye colors present in the collection

[
    {
        $group:{
            _id:"$eyeColor"
        }
    }
]

// What is the average number of tags per user?

[
    {
        $unwind:"tags"  //Break an array into multiple documents, 1 document with array → becomes multiple documents, Each element becomes its own document
    },
    {
        $group:{
            _id:"$_id",
            numberOfTags:{
                $sum: 1
            }
        }
    },
    {
        $group:{
            _id:null,
            averageTags:{
                $avg:"$numberOfTags",
            }
        }
    }
]
                        // ****OR****
[
{
    $addFields:{
        numberOfTags:{
            $size:{       //$size counts elements in array
                $ifNull:["$tags",[]] 
            }
        }
    }
},
{
    $group:{
        _id:null,
        averageNumberOfTags:{
            $avg:"$numberOfTags"
        }
    }
}
]

//How many users have 'enim' as one of their tags?
[{
    $match:{            //Filters documents based on a specified query predicate. Matched documents are passed to the next pipeline stage.
        tags:"enim"
    }
},{
    $count: "userWithEnimTags"
}
]

//What are the names and age of users who are inactive and have velit as a tag?
[
    {
        $match:{
            isActive: false,
            tags:"velit"
        },
        $project:{  //Passes along the documents with the requested fields to the next stage in the pipeline. The specified fields can be existing fields from the input documents or newly computed fields.
            name:1,
            age:1
        }
    }
]

//How many users have a phone number starting with "=1 (940)"?
[
  {
    $match: {
      "company.phone": /^\+1 \(940\)/
    }
  },
 {
  $count:"userswithSpecialPhoneNumber"
  }
]

//Who has registered the most recently?
[
    {
        $sort:{
            registered: -1
        }
    },{$limit: 5},{
        $project:{
            name:1,
            registered:1,
            favoriteFruit:1,
        }
    }
]
//Categorize users by their favoruite fruit?
[
  {
    $group: {
      _id:"$favoriteFruit",
     users:{$push:"$name"}
    }
  }
]


//how many users have 'ad' as the second tag in their list of tags?
[
  {
    $match: {
     "tags.1":"ad"
    }
  },{
    $count: "secondTagAd"
  }
]

// find users who have both 'enim' and 'id' as their tags
[
  {
   $match:{
     tags:{
        $all:["enim", "id"]  //The $all operator selects the documents where the value of a field matches all specified values. The matched documents can either contain a field with a value that is an array containing all the specified elements, or a field with a single value matching the specified element.
    }
   }
  }
]
//List all companies located in the USA with their corresponding user count
[
  {
   $match: {
     "company.location.country":"USA"
   } 
  },
  {
    $group:{
      _id:"$company.title",
      userCount:{$sum: 1}
    }
  }
]

